# ============================================
# HƯỚNG DẪN CÀI ĐẶT API KEY
# ============================================
# 1. Copy file này thành file .env:
#    cp .env.example .env   (Linux/Mac)
#    copy .env.example .env (Windows)
#
# 2. Điền API key thật của bạn vào .env
# 3. KHÔNG BAO GIỜ commit file .env lên GitHub!
# ============================================

# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Bật lưu ảnh debug (chỉ dùng khi phát triển, TẮT khi production)
DEBUG_IMAGES=false
